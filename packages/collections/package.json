{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/collections",
  "version": "0.9.0",
  "description": "Collections with no dependencies: lists, maps, queues, a summary tree, channels, lazy operations and dependency graphs.",
  "keywords": [
    "collections",
    "data-structures",
    "tree-map",
    "priority-queue",
    "lru",
    "summary-tree",
    "channels",
    "dag",
    "topological-sort",
    "typescript"
  ],
  "homepage": "https://mark1russell7.github.io/collections/",
  "bugs": {
    "url": "https://github.com/mark1russell7/collections/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/collections.git",
    "directory": "packages/collections"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dag": "./src/dag/index.ts",
    "./graph": "./src/graph/index.ts",
    "./layers": "./src/core/layers.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/contracts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./dag": {
        "types": "./build/dag/index.d.ts",
        "default": "./build/dag/index.js"
      },
      "./graph": {
        "types": "./build/graph/index.d.ts",
        "default": "./build/graph/index.js"
      },
      "./layers": {
        "types": "./build/core/layers.d.ts",
        "default": "./build/core/layers.js"
      },
      "./testing": {
        "types": "./build/testing/index.d.ts",
        "default": "./build/testing/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-bench": "^0.2.5",
    "@mark1russell7/rigor-generators": "^0.1.5",
    "@mark1russell7/rigor-statistics": "^0.1.8",
    "@mark1russell7/rigor-testkit": "^0.1.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/optional": "^1.2.0"
  }
}
